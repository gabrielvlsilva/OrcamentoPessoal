@model OrcamentoPessoal.Models.UserLogin
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acesso ao Sistema - Orçamento Pessoal & IA</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Estilos da Aplicação -->
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="login-page-body">
    <div class="login-card-container">
        <!-- Lado Visual: Identidade e Conceito do Projeto -->
        <div class="login-hero-side">
            <div class="login-hero-header">
                <span class="login-brand-badge">
                    <i class="bi bi-stars text-info"></i> Inteligência Financeira
                </span>
                <h1 class="login-hero-title">
                    Controle Orçamentário com Suporte de IA
                </h1>
                <p class="login-hero-description">
                    Uma plataforma moderna desenvolvida para simplificar sua vida financeira, automatizando a leitura de extratos, notas e faturas.
                </p>
            </div>

            <div class="login-feature-list">
                <div class="login-feature-item">
                    <div class="login-feature-icon">
                        <i class="bi bi-file-earmark-pdf"></i>
                    </div>
                    <div class="login-feature-text">
                        <strong>Leitura Inteligente de Documentos</strong><br />
                        Extração automatizada de PDFs bancários, faturas de cartão e planilhas.
                    </div>
                </div>

                <div class="login-feature-item">
                    <div class="login-feature-icon">
                        <i class="bi bi-cpu"></i>
                    </div>
                    <div class="login-feature-text">
                        <strong>Categorização Automática</strong><br />
                        A IA identifica estabelecimentos e classifica despesas sem trabalho manual.
                    </div>
                </div>

                <div class="login-feature-item">
                    <div class="login-feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="login-feature-text">
                        <strong>Padronização de Relatórios</strong><br />
                        Geração de planilhas consolidadas e gráficos claros de evolução patrimonial.
                    </div>
                </div>
            </div>

            <div class="login-hero-footer">
                <i class="bi bi-mortarboard me-1"></i> Projeto Acadêmico &bull; Faculdade de Tecnologia
            </div>
        </div>

        <!-- Lado Formulário: Acesso ao Sistema -->
        <div class="login-form-side">
            <div class="login-form-header">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="brand-logo-icon" style="width: 32px; height: 32px; font-size: 1rem;">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <span class="fw-bold text-dark fs-5">Orçamento Pessoal</span>
                </div>
                <h2 class="login-form-title">Acesse sua Conta</h2>
                <p class="login-form-subtitle">Digite seus dados para gerenciar seu orçamento</p>
            </div>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-3 rounded-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div class="small fw-semibold">@ViewBag.Message</div>
                </div>
            }

            @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { id = "frmLogin", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                <div class="mb-3">
                    <label for="txtUsuario" class="form-label">CPF</label>
                    <div class="input-icon-group">
                        <i class="bi bi-person input-icon-prefix"></i>
                        @Html.TextBoxFor(model => model.Usuario, new
                        {
                            @class = "form-control",
                            id = "txtUsuario",
                            placeholder = "Digite seu CPF",
                            autocomplete = "username",
                            required = "required"
                        })
                    </div>
                    @Html.ValidationMessageFor(model => model.Usuario, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="mb-3">
                    <label for="txtSenha" class="form-label">Senha</label>
                    <div class="input-icon-group">
                        <i class="bi bi-lock input-icon-prefix"></i>
                        @Html.PasswordFor(model => model.Senha, new
                        {
                            @class = "form-control",
                            id = "txtSenha",
                            placeholder = "Digite sua senha",
                            autocomplete = "current-password",
                            required = "required"
                        })
                        <button type="button" class="btn-toggle-password" id="btnTogglePassword" aria-label="Mostrar ou ocultar senha">
                            <i class="bi bi-eye" id="iconEye"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(model => model.Senha, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <button type="submit" class="btn-login-submit" id="btnLogin">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Entrar no Sistema</span>
                </button>
            }

        </div>
    </div>

    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        (function () {
            'use strict';

            var txtUser = document.getElementById('txtUsuario');
            var txtPass = document.getElementById('txtSenha');
            var btnToggle = document.getElementById('btnTogglePassword');
            var iconEye = document.getElementById('iconEye');

            // Alternar visibilidade da senha
            if (btnToggle && txtPass && iconEye) {
                btnToggle.addEventListener('click', function () {
                    if (txtPass.type === 'password') {
                        txtPass.type = 'text';
                        iconEye.classList.remove('bi-eye');
                        iconEye.classList.add('bi-eye-slash');
                    } else {
                        txtPass.type = 'password';
                        iconEye.classList.remove('bi-eye-slash');
                        iconEye.classList.add('bi-eye');
                    }
                });
            }

            // Máscara dinâmica de CPF
            if (txtUser) {
                txtUser.addEventListener('input', function (e) {
                    var val = e.target.value.replace(/\D/g, '');
                    if (val.length <= 11 && val.length > 0) {
                        if (val.length > 9) {
                            val = val.replace(/^(\d{3})(\d{3})(\d{3})(\d{1,2})$/, '$1.$2.$3-$4');
                        } else if (val.length > 6) {
                            val = val.replace(/^(\d{3})(\d{3})(\d{1,3})$/, '$1.$2.$3');
                        } else if (val.length > 3) {
                            val = val.replace(/^(\d{3})(\d{1,3})$/, '$1.$2');
                        }
                        e.target.value = val;
                    }
                });
            }
        })();
    </script>
</body>
</html>
