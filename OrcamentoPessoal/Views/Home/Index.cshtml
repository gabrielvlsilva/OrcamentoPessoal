@model OrcamentoPessoal.Models.UserLogin
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title class="hero-title">Login - Orçamento Pessoal</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="login-bg">
    <section class="hero container-tight d-flex justify-content-center">
        <div class="card feature-card animate-fade-up col-md-4">
            <h2 class="hero-title animate-fade-up">Login Orçamento Pessoal</h2>
            <form action="Login" method="POST">
                <div class="mb-2">
                    @Html.EditorFor(model => model.Usuario, new { htmlAttributes = new { @class = "form-group", placeholder = "Digite seu CPF" } })
                </div>

                <div>
                    @Html.EditorFor(model => model.Senha, new { htmlAttributes = new { @class = "form-group", placeholder = "Digite sua senha" } })
                </div>
                <div class="m-2 d-flex justify-content-end"><a href="#">Esqueceu a senha?</a></div>

                <div><button class="btn btn-primary justify-content-center" type="submit">Entrar</button></div>
            </form>
        </div>
    </section>
</body>
</html>
