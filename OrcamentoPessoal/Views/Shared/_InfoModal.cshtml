<div class="modal fade" id="modalInfo" tabindex="-1" aria-labelledby="modalInfoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title d-flex align-items-center gap-2" id="modalInfoLabel">
                    <i class="bi bi-info-circle-fill"></i>
                    <span id="modalInfoTitulo">Informação do Sistema</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-0 text-secondary" id="modalInfoMensagem">
                    Operação registrada com sucesso.
                </p>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="modalInfoCancelar" data-bs-dismiss="modal" hidden>Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm" id="modalInfoConfirmar" hidden>Confirmar</button>
                <button type="button" class="btn btn-primary btn-sm" id="modalInfoEntendido" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        var modalElement = document.getElementById('modalInfo');
        var tituloElement = document.getElementById('modalInfoTitulo');
        var mensagemElement = document.getElementById('modalInfoMensagem');
        var entendidoButton = document.getElementById('modalInfoEntendido');
        var cancelarButton = document.getElementById('modalInfoCancelar');
        var confirmarButton = document.getElementById('modalInfoConfirmar');
        var acaoConfirmada = null;

        window.mostrarInfoModal = function (titulo, mensagem) {
            tituloElement.textContent = titulo || 'Informação do Sistema';
            mensagemElement.textContent = mensagem || '';
            entendidoButton.hidden = false;
            cancelarButton.hidden = true;
            confirmarButton.hidden = true;
            acaoConfirmada = null;
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        };

        window.mostrarConfirmacaoModal = function (titulo, mensagem, aoConfirmar) {
            tituloElement.textContent = titulo || 'Confirmação';
            mensagemElement.textContent = mensagem || '';
            entendidoButton.hidden = true;
            cancelarButton.hidden = false;
            confirmarButton.hidden = false;
            acaoConfirmada = aoConfirmar;
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        };

        confirmarButton.addEventListener('click', function () {
            var executarAcao = acaoConfirmada;
            acaoConfirmada = null;
            bootstrap.Modal.getOrCreateInstance(modalElement).hide();
            if (executarAcao) executarAcao();
        });
    })();
</script>
