@using OrcamentoPessoal.Models
@{
    var usuarioLogado = Session["UsuarioLogado"] as Usuario;
    var nomeUsuario = usuarioLogado != null ? usuarioLogado.Nome : "Conta";
    var primeiroNome = usuarioLogado != null ? usuarioLogado.PrimeiroNome : "Conta";
    var iniciaisUsuario = usuarioLogado != null ? usuarioLogado.Iniciais : "US";
    var perfilUsuario = usuarioLogado != null ? usuarioLogado.Perfil : "Usuário";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string activeMenu = ViewBag.ActiveMenu as string ?? currentAction;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Dashboard") - Orçamento Pessoal & IA</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    @RenderSection("styles", required: false)
</head>
<body>
    <div class="app-wrapper">
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <aside class="app-sidebar" id="appSidebar" aria-label="Menu Principal de Navegação">
            <div class="sidebar-brand">
                <a href="@Url.Action("Index", "Home")" class="brand-link">
                    <div class="brand-logo-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div>
                        <h1 class="brand-title">Orçamento</h1>
                    </div>
                </a>
                <button type="button" class="sidebar-close-btn" id="btnSidebarClose" aria-label="Fechar menu">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="sidebar-nav">
                <div class="nav-section-title">Menu Principal</div>
                <ul class="sidebar-menu">
                    <li class="sidebar-item">
                        <a href="@Url.Action("Index", "Home")" class="sidebar-link @(activeMenu == "Index" || activeMenu == "Inicio" ? "active" : "")">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Visão Geral</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("Transacoes", "Home")" class="sidebar-link @(activeMenu == "Transacoes" ? "active" : "")">
                            <i class="bi bi-arrow-left-right"></i>
                            <span>Transações</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@(Url.Action("Index", "Home"))#formImportarArquivo" class="sidebar-link">
                            <i class="bi bi-robot"></i>
                            <span>Importar arquivo</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <span class="sidebar-link text-muted" aria-disabled="true" title="Funcionalidade em desenvolvimento" style="opacity: 0.65; cursor: not-allowed;">
                            <i class="bi bi-tags-fill"></i>
                            <span>Categorias & Metas</span>
                            <small class="ms-auto">Em desenvolvimento</small>
                        </span>
                    </li>
                </ul>

                <div class="nav-section-title">Análise & Gestão</div>
                <ul class="sidebar-menu">
                    <li class="sidebar-item">
                        <a href="@Url.Action("Relatorios", "Home")" class="sidebar-link @(activeMenu == "Relatorios" ? "active" : "")">
                            <i class="bi bi-bar-chart-line-fill"></i>
                            <span>Relatórios & Planilhas</span>
                        </a>
                    </li>
                    <li class="sidebar-item">
                        <a href="@Url.Action("About", "Home")" class="sidebar-link @(activeMenu == "About" ? "active" : "")">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>Sobre o Projeto</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-user">
                <div class="user-profile-preview">
                    <div class="user-avatar-circle" title="@nomeUsuario">
                        @iniciaisUsuario
                    </div>
                    <div class="user-details">
                        <span class="user-name" title="@nomeUsuario">@nomeUsuario</span>
                        <span class="user-role">@perfilUsuario</span>
                    </div>
                </div>
                @using (Html.BeginForm("Logout", "Home", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-sidebar-logout" title="Sair do Sistema" aria-label="Sair do Sistema">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                }
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-left">
                    <button type="button" class="btn-toggle-sidebar" id="sidebarToggle" aria-label="Alternar menu lateral" aria-controls="appSidebar" aria-expanded="true">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="topbar-breadcrumb">
                        <h2 class="page-title">@(ViewBag.PageTitle ?? "Visão Geral")</h2>
                    </div>
                </div>

                <div class="topbar-right">
                    <a href="@(Url.Action("Index", "Home"))#formImportarArquivo" class="btn btn-sm btn-app-ai d-none d-sm-inline-flex">
                        <i class="bi bi-upload"></i> Ler Arquivo com IA
                    </a>

                    <div class="dropdown">
                        <button class="btn btn-light d-flex align-items-center gap-2 border" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-circle" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                @iniciaisUsuario
                            </div>
                            <span class="d-none d-lg-inline fw-semibold small">@primeiroNome</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuDropdown">
                            <li class="dropdown-header">
                                <strong class="d-block text-dark">@nomeUsuario</strong>
                                <small class="text-muted">@perfilUsuario</small>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("Index", "Home")">
                                    <i class="bi bi-speedometer2 me-2 text-primary"></i> Visão Geral
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="@(Url.Action("Index", "Home"))#formImportarArquivo">
                                    <i class="bi bi-robot me-2 text-info"></i> Importador IA
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                @using (Html.BeginForm("Logout", "Home", FormMethod.Post, new { @class = "m-0" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Encerrar Sessão
                                    </button>
                                }
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-content" role="main">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <div>
                    <strong>Orçamento Pessoal & IA Financeira</strong> &copy; @DateTime.Now.Year - Projeto Acadêmico & Inovação.
                </div>
                <div class="text-muted small">
                    <i class="bi bi-cpu me-1 text-primary"></i> Análise de documentos disponível para PDF, CSV e XLSX
                </div>
            </footer>
        </div>
    </div>

    @Html.Partial("_InfoModal")

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        (function () {
            'use strict';

            var wrapper = document.querySelector('.app-wrapper');
            var sidebar = document.getElementById('appSidebar');
            var backdrop = document.getElementById('sidebarBackdrop');
            var toggleBtn = document.getElementById('sidebarToggle');
            var closeBtn = document.getElementById('btnSidebarClose');
            var mobileBreakpoint = window.matchMedia('(max-width: 991.98px)');

            function setSidebarOpen(isOpen) {
                if (!sidebar || !wrapper) return;

                if (mobileBreakpoint.matches) {
                    sidebar.classList.toggle('show', isOpen);
                    if (backdrop) backdrop.classList.toggle('show', isOpen);
                    document.body.style.overflow = isOpen ? 'hidden' : '';
                } else {
                    wrapper.classList.toggle('sidebar-collapsed', !isOpen);
                    sidebar.classList.remove('show');
                    if (backdrop) backdrop.classList.remove('show');
                    document.body.style.overflow = '';
                }

                if (toggleBtn) toggleBtn.setAttribute('aria-expanded', isOpen.toString());
            }

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    var isOpen = mobileBreakpoint.matches
                        ? sidebar && sidebar.classList.contains('show')
                        : !wrapper.classList.contains('sidebar-collapsed');

                    setSidebarOpen(!isOpen);
                });
            }

            if (closeBtn) {
                closeBtn.addEventListener('click', function () {
                    setSidebarOpen(false);
                });
            }

            if (backdrop) {
                backdrop.addEventListener('click', function () {
                    setSidebarOpen(false);
                });
            }

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') setSidebarOpen(false);
            });

            function handleBreakpointChange(event) {
                setSidebarOpen(!event.matches);
            }

            if (mobileBreakpoint.addEventListener) {
                mobileBreakpoint.addEventListener('change', handleBreakpointChange);
            } else {
                mobileBreakpoint.addListener(handleBreakpointChange);
            }

            setSidebarOpen(!mobileBreakpoint.matches);
        })();
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
